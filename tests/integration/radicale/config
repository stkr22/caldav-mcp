# Radicale for the integration suite. Used by .devcontainer/compose.yml, which
# mounts this file and `users` read-only; storage is tmpfs, so every start is empty.
[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /etc/radicale/users
htpasswd_encryption = plain

[storage]
filesystem_folder = /data/collections

[rights]
type = owner_only
