# --- The CalDAV account (required) --------------------------------------------------------------------------
# The calendar home or principal URL. https:// only, unless the host is loopback.
CALDAV_URL=https://dav.example.com/calendars/you@example.com/
CALDAV_USERNAME=CHANGE_ME
# Most hosted services want an app-specific password rather than the account password.
CALDAV_PASSWORD=CHANGE_ME

# --- Who may call this server (required) --------------------------------------------------------------------
# At least 16 characters. Clients send `Authorization: Bearer <key>` or `X-Api-Key: <key>`. Checked before any
# MCP request is processed. The server refuses to start without it, unless you opt out explicitly:
CALDAV_MCP_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# CALDAV_MCP_ALLOW_NO_AUTH=true

# --- Which tools the agent can see (optional) ---------------------------------------------------------------
# One of: comma-separated names | one prefix ending in * | the keyword "essential". Names may omit "caldav_".
# Unknown names stop the server from starting. DENY is subtracted from ALLOW.
# CALDAV_ALLOW_TOOLS=caldav_list_calendars,caldav_get_events,caldav_search_events,caldav_get_event_by_uid,caldav_get_freebusy,caldav_create_event,caldav_update_event,caldav_delete_event
# CALDAV_DENY_TOOLS=caldav_move_event
# Hide every write tool (applied last; it always wins):
CALDAV_MCP_READ_ONLY=false

# --- Behaviour (optional) -----------------------------------------------------------------------------------
# IANA zone for "today", "this week" and for date-only values. Required to be valid; there is no silent UTC fallback.
TZ=Europe/London
# First day of the week for this_week / next_week: monday (default) ... sunday
# CALDAV_WEEK_START=monday
# Calendar new events go to when the caller names none (a name or id). Without it, a caller must choose
# unless the account has exactly one calendar.
# CALDAV_DEFAULT_CALENDAR=
# Default and maximum number of events one answer returns (default 50, at most 500).
# CALDAV_MAX_EVENTS=50
# Seconds to wait for the CalDAV server (default 20).
# CALDAV_TIMEOUT_SECONDS=20

# --- HTTP server (optional) ---------------------------------------------------------------------------------
CALDAV_MCP_PORT=8080
CALDAV_MCP_PATH=/mcp
# Built-in TLS for the MCP endpoint itself (cert and key together). CA bundle = require client certificates.
# CALDAV_MCP_TLS_CERT=
# CALDAV_MCP_TLS_KEY=
# CALDAV_MCP_TLS_CA_BUNDLE=
# Behind exactly one reverse proxy that sets X-Forwarded-For: rate-limit by the address it reports.
# Leave off otherwise; a caller could pick its own address.
# CALDAV_MCP_TRUST_PROXY=true
CALDAV_MCP_RATE_LIMIT_MAX_FAILURES=10
CALDAV_MCP_RATE_LIMIT_WINDOW_SECONDS=60

# --- Things that lower protection: leave alone unless you know why ---------------------------------------
# Verify the CalDAV server's certificate (only true/false are accepted; a typo stops the server).
CALDAV_MCP_CALDAV_VERIFY_SSL=true
# Allow http:// to a non-loopback CalDAV host. The password then crosses the network in the clear.
# CALDAV_ALLOW_PLAINTEXT=true
